# Muslinx Linux Distribution — .gitignore

# Build artifacts
/build/
/toolchain/
/sources/

# Staged root filesystem (built during process)
/rootfs/

# ISO staging and output
/iso/
/output/

# Environment file (generated by 01-setup-host.sh)
scripts/helpers/common.env

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log
