--- a/lib/strtod.c
+++ b/lib/strtod.c
@@ -1,3 +1,14 @@
+/* Muslinx: musl libc compatibility patch for coreutils
+ * musl does not implement strtod_l() or locale_t from xlocale.h
+ * This patch provides fallback implementations using standard strtod()
+ */
+
+#if defined(__linux__) && !defined(__GLIBC__)
+/* musl libc detected — provide stubs for missing locale functions */
+#define strtod_l(nptr, endptr, loc) strtod(nptr, endptr)
+#define strtof_l(nptr, endptr, loc) strtof(nptr, endptr)
+#define strtold_l(nptr, endptr, loc) strtold(nptr, endptr)
+#endif
+
