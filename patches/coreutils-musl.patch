--- a/lib/locale.h
+++ b/lib/locale.h
@@ -0,0 +1,15 @@
+/* Muslinx: musl compatibility shim for locale_t
+ * musl provides locale_t in <locale.h> but not xlocale.h
+ */
+#include_next <locale.h>
+
+#if defined(__linux__) && !defined(__GLIBC__)
+#ifndef _MUSLINX_LOCALE_SHIM
+#define _MUSLINX_LOCALE_SHIM
+/* musl has locale_t in locale.h, but some GNU code expects xlocale.h */
+/* These stubs prevent compilation errors with gnulib */
+#define uselocale(x) ((locale_t)0)
+#define freelocale(x) ((void)0)
+#define newlocale(a, b, c) ((locale_t)0)
+#endif
+#endif
